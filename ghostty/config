# This is the configuration file for Ghostty.
theme = Gruvbox Light
font-size = 18
shell-integration = fish
background-opacity = 0.8 
mouse-hide-while-typing = true
bell-features = system,attention,title

# Default tab bar is to chonky for me
gtk-custom-css = ./tab_style.css

# Keybinds
keybind = super+r=clear_screen
keybind = ctrl+w=close_tab
keybind = ctrl+t=new_tab
keybind = ctrl+f=start_search

custom-shader = shaders/cursor_sweep.glsl
custom-shader = shaders/ripple_cursor.glsl
custom-shader-animation = always
